name: Audition voices
 
# Run this once from the Actions tab. It reads the same passage in each
# shortlisted British voice and commits the samples to docs/audio/auditions/,
# so you can listen and then set PIPER_VOICE in morning.yml to the winner.
on:
  workflow_dispatch:
    inputs:
      length_scale:
        description: "Delivery speed - above 1 is slower and more measured"
        default: "1.08"
      sentence_silence:
        description: "Pause between sentences, in seconds"
        default: "0.38"
 
permissions:
  contents: write
 
jobs:
  audition:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Render the samples
        env:
          PIPER_LENGTH_SCALE: ${{ inputs.length_scale }}
          PIPER_SENTENCE_SILENCE: ${{ inputs.sentence_silence }}
        run: |
          pip install --quiet piper-tts
          sudo apt-get install -y -qq ffmpeg >/dev/null 2>&1 || true
          python scripts/audio.py --audition
      - name: Commit the samples
        run: |
          git config user.name  "gold-risk-bot"
          git config user.email "actions@github.com"
          git add docs/audio
          git diff --staged --quiet || git commit -m "voice auditions"
          git push
 

