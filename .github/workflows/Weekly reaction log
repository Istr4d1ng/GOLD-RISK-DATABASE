"""Weekly cross-asset review.
 
The daily report stays gold-led and short. This is where the week gets read
across the whole book: what moved, what moved together, what the reaction log
learned, and where the model's priors disagree with the measurements.
"""
 
import csv
import json
import os
import statistics
import sys
from datetime import datetime, timedelta
from zoneinfo import ZoneInfo
 
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
 
import assets as assetlib
import config
import health
import reactions
import render
import risk as riskmod
import sources
 
ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT_MD = os.path.join(ROOT, "data", "weekly")
OUT_HTML = os.path.join(ROOT, "docs", "weekly")
 
 
def week_moves(bars_by_asset, days=5):
    rows = []
    for key, spec in assetlib.load_assets().items():
        bars = bars_by_asset.get(key)
        if not bars or len(bars) <= days:
            continue
        first, last = bars[-1 - days]["c"], bars[-1]["c"]
        if not first:
            continue
        highs = [b["h"] for b in bars[-days:]]
        lows = [b["l"] for b in bars[-days:]]
        rows.append({
            "key": key, "name": spec["name"], "unit": spec["unit"],
            "decimals": spec["decimals"], "last": round(last, spec["decimals"]),
            "change_pct": round((last - first) / first * 100, 2),
            "range_pct": round((max(highs) - min(lows)) / first * 100, 2),
        })
    rows.sort(key=lambda r: -abs(r["change_pct"]))
    return rows
 
 
def correlation_shift(bars_by_asset, short=20, long=120):
    """Where relationships have moved, which is the part worth knowing."""
    now = assetlib.correlations(bars_by_asset, window=short)
    base = assetlib.correlations(bars_by_asset, window=long)
    primary = assetlib.primary_key()
    out = []
    for key in now.get("assets", []):
        if key == primary:
            continue
        a = now["matrix"].get(primary, {}).get(key)
        b = base["matrix"].get(primary, {}).get(key)
        if a is None or b is None:
            continue
        out.append({"asset": key, "name": assetlib.load_assets()[key]["name"],
                    "recent": a, "usual": b, "shift": round(a - b, 2)})
    out.sort(key=lambda r: -abs(r["shift"]))
    return {"short": short, "long": long, "rows": out}
 
 
def learned(rows, min_samples=3):
    """Event/asset pairs that now have enough history to say something."""
    out = []
    seen = {}
    for r in rows:
        try:
            pct = float(r["pct_1h"])
        except (TypeError, ValueError, KeyError):
            continue
        seen.setdefault((r["event"], r["asset"]), []).append(pct)
    names = assetlib.load_assets()
    for (event, asset), vals in seen.items():
        if len(vals) < min_samples:
            continue
        out.append({"event": event, "asset": asset,
                    "name": names.get(asset, {}).get("name", asset),
                    "samples": len(vals),
                    "median": round(statistics.median([abs(v) for v in vals]), 3),
                    "signed": round(statistics.median(vals), 3)})
    out.sort(key=lambda r: -r["median"])
    return out
 
 
def disagreements(learn):
    """Where the measured sign contradicts the prior in assets.json."""
    profiles_path = os.path.join(ROOT, "data", "event_profiles.json")
    try:
        with open(profiles_path, encoding="utf-8") as fh:
            profiles = json.load(fh)["profiles"]
    except Exception:                       # noqa: BLE001
        return []
    out = []
    for row in learn:
        prof = None
        for spec in profiles.values():
            if isinstance(spec, dict) and spec.get("name") and \
                    spec["name"].lower() in row["event"].lower():
                prof = spec
                break
        drivers = (prof or {}).get("drivers")
        if not drivers:
            continue
        expected = assetlib.explain(drivers).get(row["asset"])
        if not expected or abs(expected["net"]) < 0.3 or abs(row["signed"]) < 0.05:
            continue
        if (expected["net"] > 0) != (row["signed"] > 0):
            out.append({**row, "expected": expected["net"],
                        "expected_dir": expected["direction"]})
    return out
 
 
def main():
    tz = ZoneInfo(config.DISPLAY_TZ)
    today = datetime.now(tz).date()
    health.reset()
    print(f"[weekly] building for week ending {today}")
 
    bars = health.guard("Cross-asset prices",
                        lambda: assetlib.fetch_bars("1y"), (None, []),
                        lambda v: f"{len(v[0])} assets")
    bars_by_asset = (bars or (None, []))[0] or {}
    moves = week_moves(bars_by_asset)
    shift = correlation_shift(bars_by_asset) if len(bars_by_asset) > 3 else None
    rows = reactions.load()
    learn = learned(rows)
    clash = disagreements(learn)
    cov = reactions.coverage(rows)
    calib = riskmod.calibration()
 
    L = [f"# Weekly cross-asset review - week ending {today}", ""]
    if moves:
        L += ["## What moved", "", "| Asset | Last | Week | Range |",
              "|---|---|---|---|"]
        for m in moves:
            L.append(f"| {m['name']} | {m['last']:,} | {m['change_pct']:+.2f}% | "
                     f"{m['range_pct']:.2f}% |")
        L.append("")
        best, worst = moves[0], moves[-1]
        L += [f"Biggest mover was **{best['name']}** at {best['change_pct']:+.2f}%; "
              f"quietest was {worst['name']} at {worst['change_pct']:+.2f}%.", ""]
 
    if shift and shift["rows"]:
        L += ["## What moved together", "",
              f"Correlation with {assetlib.load_assets()[assetlib.primary_key()]['name']}, "
              f"{shift['short']}-day against the {shift['long']}-day norm. "
              "The shift column is the interesting one - a relationship changing "
              "matters more than its level.", "",
              "| Asset | Recent | Usual | Shift |", "|---|---|---|---|"]
        for r in shift["rows"][:8]:
            L.append(f"| {r['name']} | {r['recent']:+.2f} | {r['usual']:+.2f} | "
                     f"{r['shift']:+.2f} |")
        L.append("")
 
    L += ["## What the log has learned", ""]
    if learn:
        L += [f"{cov['rows']} reactions logged across {cov['events']} events and "
              f"{cov['assets']} assets over {cov['days']} days.", "",
              "| Event | Asset | Median 1h | n |", "|---|---|---|---|"]
        for r in learn[:15]:
            L.append(f"| {r['event']} | {r['name']} | {r['median']:.3f}% | "
                     f"{r['samples']} |")
        L.append("")
    else:
        L += ["Nothing has three samples yet. Weekly releases reach that in about "
              "a month, monthly ones in a quarter.", ""]
 
    if clash:
        L += ["## Where the model is wrong", "",
              "Measured direction contradicts the prior in `assets.json`. These "
              "are the lines worth changing - the measurement is the fact, the "
              "prior is an opinion.", ""]
        for r in clash[:10]:
            L.append(f"- **{r['event']} -> {r['name']}**: expected "
                     f"{r['expected_dir']} ({r['expected']:+.2f}), measured "
                     f"{r['signed']:+.3f}% over {r['samples']} instances")
        L.append("")
 
    if calib and calib.get("ready"):
        L += ["## Model calibration", "",
              f"Predicted range was a median {calib['median_abs_error_pct']}% away "
              f"from the realised range over {calib['samples']} scored days, and "
              f"too wide {calib['over_predicted_pct']}% of the time.", ""]
 
    os.makedirs(OUT_MD, exist_ok=True)
    os.makedirs(OUT_HTML, exist_ok=True)
    md = "\n".join(L) + "\n"
    with open(os.path.join(OUT_MD, f"{today}.md"), "w", encoding="utf-8") as fh:
        fh.write(md)
 
    payload = {"date": str(today), "generated": datetime.now(tz).strftime("%H:%M %Z"),
               "risk": {"band": "MODERATE"}}
    page = render.build_weekly_page(payload, moves, shift, learn, clash, cov, calib)
    for name in (f"{today}.html", "index.html"):
        with open(os.path.join(OUT_HTML, name), "w", encoding="utf-8") as fh:
            fh.write(page)
    print(f"[weekly] wrote {len(moves)} asset moves, {len(learn)} learned pairs, "
          f"{len(clash)} disagreements")
    return 0
 
 
if __name__ == "__main__":
    raise SystemExit(main())
 

